<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleDisplayName</key><string>Kinora</string>
	<key>CFBundleExecutable</key><string>Kinora</string>
	<key>CFBundleIdentifier</key><string>io.github.sky-walkerx.kinora</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>Kinora</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>__VERSION__</string>
	<key>CFBundleVersion</key><string>__BUILD__</string>
	<key>LSApplicationCategoryType</key><string>public.app-category.lifestyle</string>
	<key>LSMinimumSystemVersion</key><string>26.0</string>
	<key>NSHumanReadableCopyright</key><string>Copyright © 2026 The Kinora Contributors. Free software under the GNU GPL, version 3 or later.</string>
	<key>NSPrincipalClass</key><string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key><false/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key><string>Video</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key><array><string>public.movie</string><string>org.webmproject.webm</string><string>org.matroska.mkv</string></array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key><string>Kinora Wallpaper</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Owner</string>
			<key>LSItemContentTypes</key><array><string>io.github.sky-walkerx.kinora.wallpaper-package</string></array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>io.github.sky-walkerx.kinora.wallpaper-package</string>
			<key>UTTypeDescription</key><string>Kinora Wallpaper</string>
			<key>UTTypeConformsTo</key><array><string>public.zip-archive</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>kinorawallpaper</string></array>
			</dict>
		</dict>
	</array>
	<!-- WebM and Matroska, which Kinora converts at import. Imported, so the system's own
	     declarations win where macOS has them. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>org.webmproject.webm</string>
			<key>UTTypeDescription</key><string>WebM Video</string>
			<key>UTTypeConformsTo</key><array><string>public.movie</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>webm</string></array>
				<key>public.mime-type</key><array><string>video/webm</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>org.matroska.mkv</string>
			<key>UTTypeDescription</key><string>Matroska Video</string>
			<key>UTTypeConformsTo</key><array><string>public.movie</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>mkv</string><string>mk3d</string></array>
				<key>public.mime-type</key><array><string>video/x-matroska</string></array>
			</dict>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key><string>io.github.sky-walkerx.kinora</string>
			<key>CFBundleURLSchemes</key><array><string>kinora</string></array>
		</dict>
	</array>
</dict>
</plist>
